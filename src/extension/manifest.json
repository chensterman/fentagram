{
  "manifest_version": 3,
  "name": "Fentagram",
  "version": "0.1.0",
  "description": "See who does not follow you back, and who unfollowed you since the last sync.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fentagram"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
